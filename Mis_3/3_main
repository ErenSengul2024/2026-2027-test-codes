WHITE = (255, 255, 255)
MAGENTA = (255, 0, 255)

MODES = ("auto", "red", "qr")
MODE_LABEL = {"auto": "OTO", "red": "KIRMIZI", "qr": "QR"}
WIN_MAIN = "Gorev 3 - Kilitlenme"
WIN_MASK = "Maske"
QR_FLASH_SEC = 4.0      


def parse_args():
    p = argparse.ArgumentParser(description="Vuruş alanı + kilitlenme + QR modu")
    p.add_argument("--source", default="0",
                   help="Kamera indeksi (0, 1, ...) veya video dosyası yolu")
    p.add_argument("--mode", choices=MODES, default="auto",
                   help="auto = kırmızı takip + alanda QR önceliği | red | qr")
    p.add_argument("--width", type=int, default=640,
                   help="İşleme genişliği; daha büyük kareler küçültülür")

    p.add_argument("--h-width", type=int, default=H_WIDTH, help="Kırmızı hue toleransı")
    p.add_argument("--s-min", type=int, default=S_MIN, help="Minimum doygunluk")
    p.add_argument("--v-min", type=int, default=V_MIN, help="Minimum parlaklık")
    p.add_argument("--min-area", type=int, default=MIN_AREA, help="Minimum alan (px²)")
    p.add_argument("--min-circularity", type=float, default=0.0, help="0-1, 0 = kapalı")

    p.add_argument("--zone-area", type=float, default=0.25,
                   help="Vuruş alanının görüntü alanına oranı (0.25 = %%25)")
    p.add_argument("--lock-time", type=float, default=4.0,
                   help="Kilitlenme için alanda kesintisiz kalma süresi (sn)")
    p.add_argument("--grace", type=float, default=0.2,
                   help="Bundan kısa hedef kaybı sayacı sıfırlamaz (sn)")
    p.add_argument("--qr-hold", type=float, default=0.3,
                   help="QR görünmese bile odağın bu kadar sn korunması (titreşim önleme)")
    p.add_argument("--qr-min-area", type=int, default=400,
                   help="Bundan küçük QR adayları yok sayılır (px²)")
    p.add_argument("--log", default="kilitlenme_kaydi.csv",
                   help="Kilitlenme ve QR olaylarının yazılacağı CSV dosyası")
    p.add_argument("--record", metavar="DOSYA", help="İşlenmiş görüntüyü mp4 olarak kaydet")
    p.add_argument("--no-display", action="store_true", help="Pencere açma (test için)")
    p.add_argument("--max-frames", type=int, default=0, help="N kare sonra dur (0 = sınırsız)")
    args = p.parse_args()
    if not 0 < args.zone_area <= 1:
        p.error("--zone-area 0 ile 1 arasında olmalı (örn. 0.25)")
    return args

_FONT_PATHS = [
    "C:/Windows/Fonts/segoeuib.ttf", "C:/Windows/Fonts/arialbd.ttf", "C:/Windows/Fonts/arial.ttf",
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf", "/System/Library/Fonts/Supplemental/Arial.ttf",
    "/Library/Fonts/Arial.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
]
_TR_FOLD = str.maketrans("İıŞşĞğÜüÖöÇç", "IiSsGgUuOoCc")
_font_cache = {}

try:
    from PIL import Image, ImageDraw, ImageFont
    _FONT_FILE = next((f for f in _FONT_PATHS if os.path.exists(f)), None)
except ImportError:  
    _FONT_FILE = None


def _pil_font(size):
    if size not in _font_cache:
        _font_cache[size] = ImageFont.truetype(_FONT_FILE, size)
    return _font_cache[size]


def text_size(text, size):
    """(genişlik, yükseklik) piksel."""
    if _FONT_FILE:
        l, t, r, b = _pil_font(size).getbbox(text, stroke_width=2)
        return r - l, b - t
    (w, h), _ = cv2.getTextSize(text.translate(_TR_FOLD), cv2.FONT_HERSHEY_SIMPLEX,
                                size / 30.0, max(1, round(size / 15)))
    return w, h


def put_text(frame, text, org, size=22, color=WHITE):
    """org = metnin SOL-ÜST köşesi. Türkçe karakterleri doğru çizer, siyah kenarlıdır."""
    x, y = int(org[0]), int(org[1])
    if _FONT_FILE:
        font = _pil_font(size)
        l, t, r, b = font.getbbox(text, stroke_width=2)
        w, h = r - l, b - t
        fill = Image.new("L", (w, h), 0)
        edge = Image.new("L", (w, h), 0)
        ImageDraw.Draw(fill).text((-l, -t), text, font=font, fill=255)
        ImageDraw.Draw(edge).text((-l, -t), text, font=font, fill=255, stroke_width=2)
        fill, edge = np.asarray(fill, np.float32) / 255, np.asarray(edge, np.float32) / 255
        x0, y0 = max(x, 0), max(y, 0)
        x1, y1 = min(x + w, frame.shape[1]), min(y + h, frame.shape[0])
        if x1 <= x0 or y1 <= y0:
            return
        sx, sy = x0 - x, y0 - y
        fill = fill[sy:sy + (y1 - y0), sx:sx + (x1 - x0), None]
        edge = edge[sy:sy + (y1 - y0), sx:sx + (x1 - x0), None]
        roi = frame[y0:y1, x0:x1].astype(np.float32)
        roi = roi * (1 - edge)       
        roi = roi * (1 - fill) + np.array(color, np.float32) * fill 
        frame[y0:y1, x0:x1] = roi.astype(np.uint8)
        return

    scale, thick = size / 30.0, max(1, round(size / 15))
    folded = text.translate(_TR_FOLD)
    (_, h), _ = cv2.getTextSize(folded, cv2.FONT_HERSHEY_SIMPLEX, scale, thick)
    base = (x, y + h)
    cv2.putText(frame, folded, base, cv2.FONT_HERSHEY_SIMPLEX, scale, (0, 0, 0), thick + 3, cv2.LINE_AA)
    cv2.putText(frame, folded, base, cv2.FONT_HERSHEY_SIMPLEX, scale, color, thick, cv2.LINE_AA)
    for i, ch in enumerate(text):
        if ch == "İ":
            x_i = x + cv2.getTextSize(folded[:i], cv2.FONT_HERSHEY_SIMPLEX, scale, thick)[0][0]
            w_i = cv2.getTextSize(folded[i], cv2.FONT_HERSHEY_SIMPLEX, scale, thick)[0][0]
            cv2.circle(frame, (x_i + w_i // 2, y - 2), max(2, thick), color, -1, cv2.LINE_AA)


def fit_text(text, size, max_w):

    text = " ".join(text.split())
    if text_size(text, size)[0] <= max_w:
        return text
    while text and text_size(text + "...", size)[0] > max_w:
        text = text[:-1]
    return text + "..."


def make_zone(w, h, area_ratio):
    side = math.sqrt(area_ratio)
    zw, zh = int(round(w * side)), int(round(h * side))
    x0, y0 = (w - zw) // 2, (h - zh) // 2
    return x0, y0, x0 + zw, y0 + zh


def in_rect(pt, rect):
    return rect[0] <= pt[0] <= rect[2] and rect[1] <= pt[1] <= rect[3]


class LockLogic:

    def __init__(self, lock_time, grace):
        self.lock_time, self.grace = lock_time, grace
        self._reset()

    def _reset(self):
        self.enter_t = None      
        self.last_in_t = None    
        self.lock_t = None       
    @property
    def locked(self):
        return self.lock_t is not None

    def elapsed(self, t):
        return 0.0 if self.enter_t is None else min(t - self.enter_t, self.lock_time)

    def _break(self):
        ev = ("lock_end", self.enter_t, self.lock_t, self.last_in_t) if self.locked else None
        self._reset()
        return ev

    def update(self, t, in_zone):
        events = []
        if self.last_in_t is not None and t - self.last_in_t > self.grace + 1e-6:
            ev = self._break()                   
            if ev:
                events.append(ev)
        if in_zone:
            if self.enter_t is None:
                self.enter_t = t
            self.last_in_t = t
            if not self.locked and t - self.enter_t >= self.lock_time - 1e-6:
                self.lock_t = t
                events.append(("lock_start", self.enter_t, t))
        return events

    def finish(self):
        ev = self._break()
        return [ev] if ev else []


