def make_qr_detector():

    return cv2.QRCodeDetectorAruco() if hasattr(cv2, "QRCodeDetectorAruco") else cv2.QRCodeDetector()


def detect_qr(detector, frame, min_area):

    try:
        ok, pts = detector.detectMulti(frame)
        if not ok or pts is None:
            ok, pts = detector.detect(frame)             # tekli QR yedeği
        if not ok or pts is None:
            return []
        pts = np.asarray(pts, np.float32).reshape(-1, 4, 2)
        texts = [""] * len(pts)
        try:
            _, decoded, _ = detector.decodeMulti(frame, pts)
            if decoded is not None and len(decoded) == len(pts):
                texts = list(decoded)
        except (cv2.error, ValueError):
            pass
        if len(pts) == 1 and not texts[0]:
            texts[0] = detector.decode(frame, pts[0])[0]
    except (cv2.error, UnicodeError):
        return []
    found = []
    for text, poly in zip(texts, pts):
        area = cv2.contourArea(poly)
        if area < min_area:
            continue
        cx, cy = poly.mean(axis=0)
        found.append({"text": text, "poly": poly.astype(np.int32),
                      "center": (int(cx), int(cy)), "area": area})
    found.sort(key=lambda d: d["area"], reverse=True)
    return found


class QrFocus:


    def __init__(self, hold):
        self.hold = hold
        self.active = False
        self.text = ""
        self.poly = None
        self.center = None
        self.last_seen = None
        self.read_t = None          # bu oturumda içeriğin ilk okunduğu an
        self.flash_until = -1.0

    def _close(self):
        ev = ("end", self.read_t, self.last_seen, self.text) if self.text else None
        self.active, self.text, self.read_t = False, "", None
        return ev

    def update(self, t, det):
        """det: bu karedeki seçilmiş QR (veya None). Olay listesi döndürür."""
        events = []
        if det is not None:
            if self.active and det["text"] and self.text and det["text"] != self.text:
                events.append(self._close())               # başka bir QR gösterildi
            if not self.active:
                self.active, self.text, self.read_t = True, "", None
            self.poly, self.center, self.last_seen = det["poly"], det["center"], t
            if det["text"]:
                if self.read_t is None:
                    self.read_t = t
                    self.flash_until = t + QR_FLASH_SEC
                    events.append(("read", t, det["text"]))
                self.text = det["text"]
        elif self.active and t - self.last_seen > self.hold:
            events.append(self._close())
        return [e for e in events if e]

    def finish(self):
        ev = self._close() if self.active else None
        return [ev] if ev else []


class EventLog:
    HEADER = ["olay", "baslangic", "bitis", "sure_sn", "baslangic_t_sn", "bitis_t_sn", "detay"]

    def __init__(self, path, start_wall):
        self.start_wall = start_wall
        new = not os.path.exists(path) or os.path.getsize(path) == 0
        self.f = open(path, "a", newline="", encoding="utf-8-sig")
        self.w = csv.writer(self.f)
        if new:
            self.w.writerow(self.HEADER)
            self.f.flush()

    def stamp(self, t):
        return (self.start_wall + timedelta(seconds=t)).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]

    def clock(self, t):
        return self.stamp(t)[11:]

    def _row(self, olay, t0, t1, detay):
        self.w.writerow([olay, self.stamp(t0), self.stamp(t1), f"{t1 - t0:.2f}",
                         f"{t0:.2f}", f"{t1:.2f}", detay])
        self.f.flush()

    def lock(self, enter_t, start_t, end_t):
        self._row("KILITLENME", start_t, end_t, f"alana giris: {self.stamp(enter_t)}")

    def qr(self, read_t, end_t, text):
        self._row("QR_OKUMA", read_t, end_t, text)

    def close(self):
        self.f.close()


class FrameClock:


    def __init__(self, cap, is_file):
        self.is_file = is_file
        fps = cap.get(cv2.CAP_PROP_FPS)
        self.fps = fps if fps and fps > 1 else 30.0
        self.index = -1
        self.t0 = None

    def tick(self):
        self.index += 1
        now = time.perf_counter()
        if self.t0 is None:
            self.t0 = now
        return self.index / self.fps if self.is_file else now - self.t0


def draw_zone(frame, zone, color, thick, locked):
    x0, y0, x1, y1 = zone
    if locked: 
        overlay = frame.copy()
        cv2.rectangle(overlay, (x0, y0), (x1, y1), GREEN, -1)
        cv2.addWeighted(overlay, 0.18, frame, 0.82, 0, frame)
    cv2.rectangle(frame, (x0, y0), (x1, y1), color, thick)
    label = "VURUS ALANI"
    lw, _ = text_size(label, 16)
    put_text(frame, label, (x1 - lw, max(y0 - 24, 2)), 16, color)


def draw_progress(frame, zone, ratio, locked):
    x0, _, x1, y1 = zone
    y = y1 + 6
    cv2.rectangle(frame, (x0, y), (x1, y + 9), (0, 0, 0), -1)
    cv2.rectangle(frame, (x0, y), (x0 + int((x1 - x0) * ratio), y + 9), GREEN if locked else YELLOW, -1)
    cv2.rectangle(frame, (x0, y), (x1, y + 9), WHITE, 1)


def draw_banner(frame, text, y, color, size=40):
    w, _ = text_size(text, size)
    put_text(frame, text, ((frame.shape[1] - w) // 2, y), size, color)


def draw_red_target(frame, candidates, img_center, locked):
    for c in candidates[1:]: 
        x, y, bw, bh = c["bbox"]
        cv2.rectangle(frame, (x, y), (x + bw, y + bh), GRAY, 1)
    x, y, bw, bh = candidates[0]["bbox"]
    cx, cy = candidates[0]["center"]
    cv2.rectangle(frame, (x, y), (x + bw, y + bh), GREEN, 3 if locked else 2)
    cv2.putText(frame, "HEDEF", (x, max(y - 8, 14)), cv2.FONT_HERSHEY_SIMPLEX, 0.55, GREEN, 2, cv2.LINE_AA)
    cv2.line(frame, img_center, (cx, cy), CYAN, 1, cv2.LINE_AA)
    cv2.circle(frame, (cx, cy), 5, YELLOW, -1, cv2.LINE_AA)
    cv2.drawMarker(frame, (cx, cy), YELLOW, cv2.MARKER_CROSS, 20, 1, cv2.LINE_AA)


def draw_qr_target(frame, qr, img_center):
    cv2.polylines(frame, [qr.poly.reshape(-1, 1, 2)], True, MAGENTA, 3, cv2.LINE_AA)
    cx, cy = qr.center
    cv2.line(frame, img_center, (cx, cy), CYAN, 1, cv2.LINE_AA)
    cv2.circle(frame, (cx, cy), 5, YELLOW, -1, cv2.LINE_AA)
    x, y = qr.poly[:, 0].min(), qr.poly[:, 1].min()
    cv2.putText(frame, "QR HEDEF", (int(x), max(int(y) - 8, 14)),
                cv2.FONT_HERSHEY_SIMPLEX, 0.55, MAGENTA, 2, cv2.LINE_AA)


def draw_qr_bar(frame, text):
    h, w = frame.shape[:2]
    overlay = frame.copy()
    cv2.rectangle(overlay, (0, h - 40), (w, h), (0, 0, 0), -1)
    cv2.addWeighted(overlay, 0.65, frame, 0.35, 0, frame)
    shown = fit_text(f"QR: {text}", 22, w - 20) if text else "QR algilandi, okunuyor..."
    put_text(frame, shown, (10, h - 34), 22, MAGENTA if text else YELLOW)


def main():
    args = parse_args()
    source = int(args.source) if args.source.isdigit() else args.source
    cap = open_source(source)
    if not cap.isOpened():
        sys.exit(f"HATA: kaynak açılamadı: {args.source}")

    is_file = not isinstance(source, int)
    show = not args.no_display
    mode = args.mode
    detector = make_qr_detector()
    clock = FrameClock(cap, is_file)
    lock = LockLogic(args.lock_time, args.grace)
    qr = QrFocus(args.qr_hold)
    log = None

    writer, out_fps, written = None, 30.0, 0
    show_mask = False
    fps, frames, prev = 0.0, 0, time.perf_counter()
    t_start = prev
    t = 0.0

    def handle_lock(events):
        for ev in events:
            if ev[0] == "lock_start":
                print(f"[{log.clock(ev[2])}] KILITLENDI (hedef {args.lock_time:g} sn kesintisiz alanda kaldi)")
            else:
                _, enter_t, start_t, end_t = ev
                log.lock(enter_t, start_t, end_t)
                print(f"[{log.clock(end_t)}] KILIT BITTI (sure {end_t - start_t:.2f} sn)")

    def handle_qr(events):
        for ev in events:
            if ev[0] == "read":
                print(f"[{log.clock(ev[1])}] QR OKUNDU: {ev[2]}")
            else:
                _, read_t, end_t, text = ev
                log.qr(read_t, end_t, text)

    try:
        while True:
            ok, frame = cap.read()
            if not ok:
                break       
            t = clock.tick()
            if log is None:
                log = EventLog(args.log, datetime.now())

            if frame.shape[1] > args.width:
                s = args.width / frame.shape[1]
                frame = cv2.resize(frame, None, fx=s, fy=s, interpolation=cv2.INTER_AREA)
            h, w = frame.shape[:2]
            zone = make_zone(w, h, args.zone_area)
            img_center = (w // 2, h // 2)

            best_qr = None
            if mode in ("auto", "qr"):
                dets = detect_qr(detector, frame, args.qr_min_area)
                if mode == "auto":
                    dets = [d for d in dets if in_rect(d["center"], zone)]
                best_qr = dets[0] if dets else None
            handle_qr(qr.update(t, best_qr))
            qr_focus = qr.active and mode != "red"

            mask, candidates = None, []
            if not qr_focus and mode in ("auto", "red"):
                mask = red_mask(frame, args.h_width, args.s_min, args.v_min)
                candidates = find_candidates(mask, args.min_area, args.min_circularity)

            red_in_zone = bool(candidates) and in_rect(candidates[0]["center"], zone)
            handle_lock(lock.update(t, red_in_zone))

            now = time.perf_counter()
            dt, prev = now - prev, now
            if dt > 0:
                fps = 1.0 / dt if fps == 0 else 0.9 * fps + 0.1 * (1.0 / dt)

            cv2.drawMarker(frame, img_center, CYAN, cv2.MARKER_CROSS, 24, 1, cv2.LINE_AA)
            if mode != "qr":
                counting = lock.enter_t is not None
                zone_color = GREEN if lock.locked else (YELLOW if counting else WHITE)
                draw_zone(frame, zone, zone_color, 3 if lock.locked else 2, lock.locked)
                if counting:
                    draw_progress(frame, zone, lock.elapsed(t) / args.lock_time, lock.locked)

            lines = [(f"FPS: {fps:5.1f}", GREEN), (f"Mod: {MODE_LABEL[mode]}", WHITE)]
            if qr_focus:
                lines.append(("Hedef: QR KOD", MAGENTA))
                if qr.center:
                    lines += [(f"Merkez: ({qr.center[0]}, {qr.center[1]})", WHITE),
                              (f"Sapma: {qr.center[0] - img_center[0]:+d},{qr.center[1] - img_center[1]:+d} px", YELLOW)]
                draw_qr_target(frame, qr, img_center)
                draw_qr_bar(frame, qr.text)
            elif candidates:
                cx, cy = candidates[0]["center"]
                lines += [(f"Hedef: KIRMIZI ({len(candidates)})", WHITE),
                          (f"Merkez: ({cx}, {cy})", WHITE),
                          (f"Sapma: {cx - img_center[0]:+d},{cy - img_center[1]:+d} px", YELLOW)]
                draw_red_target(frame, candidates, img_center, lock.locked)
            else:
                lines.append(("QR bekleniyor" if mode == "qr" else "Hedef yok", RED))
            if mode != "qr":
                if lock.locked:
                    lines.append(("Kilit: AKTIF", GREEN))
                elif lock.enter_t is not None:
                    lines.append((f"Kilit: {lock.elapsed(t):.1f}/{args.lock_time:g} sn", YELLOW))
                else:
                    lines.append(("Kilit: -", GRAY))
            draw_text_panel(frame, lines)

            banner_y = zone[3] + 22
            if lock.locked:
                draw_banner(frame, "KİLİTLENDİ", banner_y, GREEN)
            elif t <= qr.flash_until and qr_focus and qr.text:
                draw_banner(frame, "QR OKUNDU", banner_y, MAGENTA)

            frames += 1

            if args.record:
                if writer is None:
                    src_fps = cap.get(cv2.CAP_PROP_FPS)
                    out_fps = src_fps if src_fps and src_fps > 1 else 30.0
                    writer = cv2.VideoWriter(args.record, cv2.VideoWriter_fourcc(*"mp4v"),
                                             out_fps, (w, h))
                target_n = int(t * out_fps + 1e-6) + 1
                while written < target_n:
                    writer.write(frame)
                    written += 1

            if show:
                cv2.imshow(WIN_MAIN, frame)
                if show_mask and mask is not None:
                    cv2.imshow(WIN_MASK, mask)
                key = cv2.waitKey(1) & 0xFF
                if key in (27, ord("q")):
                    break
                if key == ord("m"):
                    show_mask = not show_mask
                    if not show_mask:
                        cv2.destroyWindow(WIN_MASK)
                if key == ord("t"):            
                    handle_lock(lock.finish())
                    handle_qr(qr.finish())
                    mode = MODES[(MODES.index(mode) + 1) % len(MODES)]

            if args.max_frames and frames >= args.max_frames:
                break
    finally:
        if log is not None:                
            handle_lock(lock.finish())
            handle_qr(qr.finish())
            log.close()
        cap.release()
        if writer is not None:
            writer.release()
        cv2.destroyAllWindows()

    elapsed = time.perf_counter() - t_start
    if frames:
        print(f"{frames} kare işlendi, ortalama {frames / elapsed:.1f} FPS | kayıt dosyası: {args.log}")
    else:
        print("HATA: Hiç görüntü alınamadı. Kamera başka bir uygulamada açık olabilir; "
              "--source 1 deneyin.", file=sys.stderr)


if __name__ == "__main__":
    main()
