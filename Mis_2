
import argparse
import sys
import time

import cv2 
import numpy as np


H_WIDTH = 10      
S_MIN = 120       
V_MIN = 70        
MIN_AREA = 800    

WIN_MAIN = "Kirmizi hedef takibi"
WIN_MASK = "Maske"
WIN_TUNE = "Ayar"


CYAN = (255, 255, 0)
GREEN = (0, 255, 0)
YELLOW = (0, 255, 255)
GRAY = (190, 190, 190)
RED = (0, 0, 255)


def parse_args():
    p = argparse.ArgumentParser(description="HSV ile kırmızı balon/top takibi")
    p.add_argument("--source", default="0",
                   help="Kamera indeksi (0, 1, ...) veya video dosyası yolu")
    p.add_argument("--width", type=int, default=640,
                   help="İşleme genişliği; daha büyük kareler küçültülür (hız için)")
    p.add_argument("--h-width", type=int, default=H_WIDTH, help="Kırmızı hue toleransı")
    p.add_argument("--s-min", type=int, default=S_MIN, help="Minimum doygunluk")
    p.add_argument("--v-min", type=int, default=V_MIN, help="Minimum parlaklık")
    p.add_argument("--min-area", type=int, default=MIN_AREA, help="Minimum alan (px²)")
    p.add_argument("--min-circularity", type=float, default=0.0,
                   help="0-1 arası; 0 = kapalı. Yuvarlak olmayan kırmızı nesneleri eler "
                        "(top/balon için 0.5-0.7 denenebilir)")
    p.add_argument("--tune", action="store_true", help="Kaydırma çubuklarıyla canlı ayar")
    p.add_argument("--record", metavar="DOSYA", help="İşlenmiş görüntüyü mp4 olarak kaydet")
    p.add_argument("--no-display", action="store_true", help="Pencere açma (test için)")
    p.add_argument("--max-frames", type=int, default=0, help="N kare sonra dur (0 = sınırsız)")
    return p.parse_args()


def red_mask(frame_bgr, h_width, s_min, v_min):

    
    blurred = cv2.GaussianBlur(frame_bgr, (7, 7), 0)
    hsv = cv2.cvtColor(blurred, cv2.COLOR_BGR2HSV)

    low1 = np.array([0, s_min, v_min], dtype=np.uint8)
    up1 = np.array([h_width, 255, 255], dtype=np.uint8)
    low2 = np.array([180 - h_width, s_min, v_min], dtype=np.uint8)
    up2 = np.array([179, 255, 255], dtype=np.uint8)
    mask = cv2.bitwise_or(cv2.inRange(hsv, low1, up1), cv2.inRange(hsv, low2, up2))

    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel, iterations=2)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel, iterations=2)
    return mask


def find_candidates(mask, min_area, min_circularity):
    """Maskedeki uygun nesneleri alanına göre büyükten küçüğe sıralı döndürür."""
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    candidates = []
    for c in contours:
        area = cv2.contourArea(c)
        if area < min_area:
            continue
        if min_circularity > 0:
            perimeter = cv2.arcLength(c, True)
            if perimeter == 0 or 4 * np.pi * area / perimeter ** 2 < min_circularity:
                continue
        m = cv2.moments(c)
        if m["m00"] == 0:
            continue
        candidates.append({
            "area": area,
            "bbox": cv2.boundingRect(c),  
            "center": (int(m["m10"] / m["m00"]), int(m["m01"] / m["m00"])),
        })
    candidates.sort(key=lambda d: d["area"], reverse=True)
    return candidates


def draw_text_panel(frame, lines):

    font, scale, thick, pad = cv2.FONT_HERSHEY_SIMPLEX, 0.6, 2, 8
    sizes = [cv2.getTextSize(t, font, scale, thick)[0] for t, _ in lines]
    line_h = max(s[1] for s in sizes) + 10
    panel_w = max(s[0] for s in sizes) + 2 * pad
    panel_h = line_h * len(lines) + pad
    cv2.rectangle(frame, (0, 0), (panel_w, panel_h), (0, 0, 0), -1)
    for i, (text, color) in enumerate(lines):
        cv2.putText(frame, text, (pad, pad + line_h * (i + 1) - 6),
                    font, scale, color, thick, cv2.LINE_AA)


def annotate(frame, candidates, fps):

    h, w = frame.shape[:2]
    img_center = (w // 2, h // 2)
    cv2.drawMarker(frame, img_center, CYAN, cv2.MARKER_CROSS, 24, 1, cv2.LINE_AA)

    lines = [(f"FPS: {fps:5.1f}", GREEN),
             (f"Kirmizi nesne: {len(candidates)}", (255, 255, 255))]

    if candidates:

        for c in candidates[1:]:
            x, y, bw, bh = c["bbox"]
            cv2.rectangle(frame, (x, y), (x + bw, y + bh), GRAY, 1)

        target = candidates[0] 
        x, y, bw, bh = target["bbox"]
        cx, cy = target["center"]
        dx, dy = cx - img_center[0], cy - img_center[1]

        cv2.rectangle(frame, (x, y), (x + bw, y + bh), GREEN, 2)
        cv2.putText(frame, "HEDEF", (x, max(y - 8, 14)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, GREEN, 2, cv2.LINE_AA)
        cv2.line(frame, img_center, (cx, cy), CYAN, 1, cv2.LINE_AA)
        cv2.circle(frame, (cx, cy), 5, YELLOW, -1, cv2.LINE_AA)
        cv2.drawMarker(frame, (cx, cy), YELLOW, cv2.MARKER_CROSS, 20, 1, cv2.LINE_AA)

        lines += [(f"Merkez: ({cx}, {cy})", (255, 255, 255)),
                  (f"Sapma X: {dx:+d} px", YELLOW),
                  (f"Sapma Y: {dy:+d} px", YELLOW)]
    else:
        lines.append(("Hedef yok", RED))

    draw_text_panel(frame, lines)

def open_source(source):

    if isinstance(source, int) and sys.platform.startswith("win"):
        cap = cv2.VideoCapture(source, cv2.CAP_DSHOW)
        if cap.isOpened():
            return cap
        cap.release()
    return cv2.VideoCapture(source)

def nop(_):
    pass


def main():
    args = parse_args()
    source = int(args.source) if args.source.isdigit() else args.source

    cap = open_source(source)
    if not cap.isOpened():
        sys.exit(f"HATA: kaynak açılamadı: {args.source}")

    show = not args.no_display
    if args.tune and show:
        cv2.namedWindow(WIN_TUNE)
        cv2.resizeWindow(WIN_TUNE, 420, 160)
        cv2.createTrackbar("H genislik", WIN_TUNE, args.h_width, 30, nop)
        cv2.createTrackbar("S min", WIN_TUNE, args.s_min, 255, nop)
        cv2.createTrackbar("V min", WIN_TUNE, args.v_min, 255, nop)
        cv2.createTrackbar("Min alan", WIN_TUNE, args.min_area, 20000, nop)

    h_width, s_min, v_min, min_area = args.h_width, args.s_min, args.v_min, args.min_area
    writer = None
    show_mask = False
    fps = 0.0
    frames = 0
    t_start = prev = time.perf_counter()

    while True:
        ok, frame = cap.read()
        if not ok:
            break  

        if frame.shape[1] > args.width:
            scale = args.width / frame.shape[1]
            frame = cv2.resize(frame, None, fx=scale, fy=scale, interpolation=cv2.INTER_AREA)

        if args.tune and show:
            h_width = cv2.getTrackbarPos("H genislik", WIN_TUNE)
            s_min = cv2.getTrackbarPos("S min", WIN_TUNE)
            v_min = cv2.getTrackbarPos("V min", WIN_TUNE)
            min_area = max(1, cv2.getTrackbarPos("Min alan", WIN_TUNE))

        mask = red_mask(frame, h_width, s_min, v_min)
        candidates = find_candidates(mask, min_area, args.min_circularity)

        now = time.perf_counter()
        dt = now - prev
        prev = now
        if dt > 0:
            inst = 1.0 / dt
            fps = inst if fps == 0 else 0.9 * fps + 0.1 * inst

        annotate(frame, candidates, fps)
        frames += 1

        if args.record:
            if writer is None:
                src_fps = cap.get(cv2.CAP_PROP_FPS)
                writer = cv2.VideoWriter(
                    args.record, cv2.VideoWriter_fourcc(*"mp4v"),
                    src_fps if src_fps and src_fps > 1 else 30.0,
                    (frame.shape[1], frame.shape[0]))
            writer.write(frame)

        if show:
            cv2.imshow(WIN_MAIN, frame)
            if show_mask:
                cv2.imshow(WIN_MASK, mask)
            key = cv2.waitKey(1) & 0xFF
            if key in (27, ord("q")):
                break
            if key == ord("m"):
                show_mask = not show_mask
                if not show_mask:
                    cv2.destroyWindow(WIN_MASK)

        if args.max_frames and frames >= args.max_frames:
            break

    elapsed = time.perf_counter() - t_start
    cap.release()
    if writer is not None:
        writer.release()
    cv2.destroyAllWindows()

    if frames:
        print(f"{frames} kare işlendi, ortalama {frames / elapsed:.1f} FPS")
    else:
        print("HATA: Hiç görüntü alınamadı. Kamera başka bir uygulamada açık olabilir; "
              "--source 1 deneyin.", file=sys.stderr)
    if args.tune:
        print(f"Son ayarlar: --h-width {h_width} --s-min {s_min} "
              f"--v-min {v_min} --min-area {min_area}")


if __name__ == "__main__":
    main()
